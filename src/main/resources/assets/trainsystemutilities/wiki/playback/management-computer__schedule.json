{
  "schema": "manta-playback/1",
  "loop": true,
  "restartHoldMs": 1500,
  "steps": [
    {
      "target": {
        "classes": [
          "sched-row"
        ]
      },
      "do": "hover",
      "say": "trainsystemutilities.wiki.play.sched.list",
      "holdMs": 1000
    },
    {
      "target": {
        "classes": [
          "sched-row"
        ]
      },
      "do": "click",
      "say": "trainsystemutilities.wiki.play.sched.open",
      "holdMs": 1600
    },
    {
      "target": {
        "classes": [
          "sched-type-val"
        ]
      },
      "do": "wheel",
      "delta": 1,
      "say": "trainsystemutilities.wiki.play.sched.type",
      "holdMs": 500
    },
    {
      "target": {
        "classes": [
          "sched-type-val"
        ]
      },
      "do": "wheel",
      "delta": 1,
      "holdMs": 900
    },
    {
      "target": {
        "classes": [
          "sched-entries-wrap"
        ]
      },
      "do": "wheel",
      "delta": -1,
      "say": "trainsystemutilities.wiki.play.sched.entries",
      "holdMs": 1200
    },
    {
      "target": {
        "classes": [
          "sched-back"
        ]
      },
      "do": "click",
      "say": "trainsystemutilities.wiki.play.sched.back",
      "holdMs": 1200
    }
  ]
}
