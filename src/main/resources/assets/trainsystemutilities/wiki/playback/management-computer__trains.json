{
  "schema": "manta-playback/1",
  "loop": true,
  "restartHoldMs": 1500,
  "steps": [
    {
      "target": {
        "classes": [
          "train-row"
        ]
      },
      "do": "hover",
      "say": "trainsystemutilities.wiki.play.tr.list",
      "holdMs": 900
    },
    {
      "target": {
        "classes": [
          "train-row"
        ]
      },
      "do": "click",
      "say": "trainsystemutilities.wiki.play.tr.open",
      "holdMs": 1200
    },
    {
      "target": {
        "classes": [
          "train-detail-model"
        ],
        "at": [
          0.4,
          0.5
        ]
      },
      "do": "drag",
      "by": [
        50,
        0
      ],
      "durationMs": 900,
      "say": "trainsystemutilities.wiki.play.tr.rotate",
      "holdMs": 600
    },
    {
      "target": {
        "classes": [
          "train-detail-model"
        ],
        "at": [
          0.5,
          0.5
        ]
      },
      "do": "wheel",
      "delta": 1,
      "holdMs": 700
    },
    {
      "target": {
        "classes": [
          "train-detail-electrification-btn"
        ]
      },
      "do": "click",
      "say": "trainsystemutilities.wiki.play.tr.elec",
      "holdMs": 1800
    }
  ]
}
